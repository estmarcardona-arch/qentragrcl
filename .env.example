# GRUFARCOL eBR — variables de entorno (copie este archivo a .env.local y complételo).
# NUNCA suba .env.local al repositorio. Este archivo no contiene valores reales.

# --- Aplicación (públicas: llegan al navegador) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave pública (publishable key «sb_publishable_…» o la anon key heredada)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Página /_design de revisión de componentes. En desarrollo está activa por defecto;
# en el entorno de pruebas (Vercel) defina ENABLE_DESIGN_PAGE=true. En producción NO la defina.
# ENABLE_DESIGN_PAGE=

# --- Solo herramientas de desarrollo y CI (nunca en el navegador ni en Vercel) ---
# Referencia del proyecto (para generar tipos con `npm run db:types`)
SUPABASE_PROJECT_REF=
# Token personal de la CLI (supabase.com → Account → Access Tokens), solo para generar tipos
SUPABASE_ACCESS_TOKEN=
# Cadena de conexión Postgres del proyecto de desarrollo (migraciones y pruebas pgTAP).
# Supabase → Connect → Session pooler. Ejemplo:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# La clave service_role NO se usa en la etapa E0. Si una etapa futura la requiere,
# solo existirá en el servidor y se documentará aquí sin valor.

# Secreto «Protection Bypass for Automation» de Vercel (Settings → Deployment Protection).
# Solo para verificar desde el equipo los despliegues protegidos (/api/health). Nunca en Vercel ni en el navegador.
VERCEL_AUTOMATION_BYPASS_SECRET=
